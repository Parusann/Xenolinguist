# Vendored espeak-ng is a binary toolchain (exe, DLL, compiled phoneme data).
# Never apply line-ending conversion — it would corrupt the data files on checkout.
vendor/espeak-ng/** binary
vendor/whisper/win/* binary
*.dll binary
*.bin binary
# Test audio fixtures are binary PCM WAV — keep byte-exact.
*.wav binary
vendor/ipa-model/** binary
*.onnx binary
# Retained W22 browser captures have published byte hashes; preserve their original bytes.
docs/verification/w22-number-elicitation-*profile.json -text
docs/verification/w22-number-elicitation-history.xeno binary
docs/verification/w22-grammar-elicitation-*profile.json -text
docs/verification/w22-grammar-elicitation-history.xeno binary
docs/verification/w22-grammar-audit-*.json -text

# Retain the exact CI audit bytes referenced by the W22 experiment verification.
docs/verification/w22-curves-audit-*.json -text
docs/verification/w22-elicitation-*.svg -text

# Preserve the byte identities of retained W23 acoustic responses and audit reports.
docs/verification/w23-ctc-*.json -text whitespace=cr-at-eol
docs/verification/w23-ctc-replay.mts -text

# Retained W23 windowing responses and reports preserve their recorded bytes.
docs/verification/w23-chunks-*.json -text whitespace=cr-at-eol
docs/verification/w23-chunks-replay.mts -text

# Preserve the byte identities of W23 annotation records and replay source.
docs/verification/w23-layers-*.json -text whitespace=cr-at-eol
docs/verification/w23-layers-replay.mts -text
docs/verification/w23-layers-*.png binary
